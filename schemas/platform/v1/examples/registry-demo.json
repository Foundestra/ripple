  "path_classifications": {
    "generated": [
      {
        "pattern": "genproto/",
        "match": "contains_or_prefix"
      }
    ],
    "documentation": [
      {
        "pattern": "README.md",
        "match": "basename"
      },
      {
        "pattern": "docs/",
        "match": "prefix"
      }
    ],
    "shared_contract": [
      {
        "pattern": "pb/demo.proto",
        "match": "exact"
      }
    ]
