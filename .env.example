# Copy to .env. Everything is optional: with nothing set, Ripple runs fully
# offline on the seeded graph snapshot, catalog, tickets and incidents.

PORT=4000

# --- Dependency graph -------------------------------------------------------
# auto = Prometheus (servicegraph) -> Jaeger -> seeded snapshot
RIPPLE_GRAPH_SOURCE=auto
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui
RIPPLE_GRAPH_REFRESH_SEC=60
RIPPLE_GRAPH_LOOKBACK_MIN=60
RIPPLE_MAX_HOPS=3
# memory | postgres (recursive CTEs)
RIPPLE_GRAPH_STORE=memory
DATABASE_URL=

# --- GitHub -----------------------------------------------------------------
# Either a token (PR comment + commit status) ...
GITHUB_TOKEN=
# ... or a GitHub App (PR comment + Checks API)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Public URL of this server, used as the check's "Details" link
RIPPLE_PUBLIC_URL=
# Also request reviews from suggested reviewers (they must be real users)
RIPPLE_REQUEST_REVIEWERS=false

# --- Planning ---------------------------------------------------------------
# seeded | jira
RIPPLE_PLANNING_SOURCE=seeded
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Agents (optional LLM) --------------------------------------------------
# gemini | anthropic | none (auto-picked from whichever key is set)
RIPPLE_LLM=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
