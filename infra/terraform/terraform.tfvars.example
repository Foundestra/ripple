# Copy to terraform.tfvars (git-ignored) and fill in.

project_id = "my-ripple-project"
region     = "us-central1"

# GitHub
github_owner       = "tanmaycodes13"
watched_repository = "opentelemetry-demo" # the fork whose PRs Ripple reviews
deploy_repository  = "ripple"             # Ripple's own repo (GitHub Actions deploys from it)
deploy_branch      = "main"
github_auth_mode   = "app"                # "app" (recommended) or "token"
github_app_id      = ""                   # fill in after create-app.mjs, then re-apply
manage_github      = false                # true = also set Actions variables (+ webhook in token mode)

# Gemini
gemini_model          = "gemini-2.5-flash"
create_gemini_api_key = true

# Optional
alert_email = ""
